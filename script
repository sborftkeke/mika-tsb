local function isValidTarget(plr)
    if not plr or plr == LocalPlayer then return false end
    if killedList[plr] or immortalList[plr] then return false end
    if isLikelyImmortal(plr) then immortalList[plr] = true; return false end
    if not getPlayerHP(plr) then return false end
    local myRoot = getMyRoot()
    if myRoot then
        local r = plr.Character:FindFirstChild("HumanoidRootPart")
        if r then
            local d = (r.Position - myRoot.Position).Magnitude
            if d > CFG.MaxTargetDist then return false end
        end
    end
    return true
end
local function pickLowestHP()
    local best, bestHP = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local hp = getPlayerHP(plr)
            if hp and hp < bestHP then bestHP = hp; best = plr end
        end
    end
    return best
end
local function pickNearest()
    local myRoot = getMyRoot(); if not myRoot then return nil end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local r = plr.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < bestDist then bestDist = d; best = plr end
            end
        end
    end
    return best
end
local function pickTarget()
    local t = (CFG.TargetMode == "lowest_hp") and pickLowestHP() or pickNearest()
    if not t then
        killedList = {}
        t = (CFG.TargetMode == "lowest_hp") and pickLowestHP() or pickNearest()
    end
    return t
end

