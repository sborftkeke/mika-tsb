local function applyNoCollide(char)
    if not char or not CFG.NoCollide then return end
    if CFG.NoCollideMode == "off" then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if CFG.NoCollideMode == "all" then
                pcall(function() part.CanCollide = false end)
            elseif CFG.NoCollideMode == "torso" then
                local n = part.Name:lower()
                if n:find("torso") or n:find("root") or n:find("head")
                   or n:find("upper") or n:find("lower") or n:find("chest")
                   or n:find("hip") then
                    pcall(function() part.CanCollide = false end)
                end
            end
        end
    end
end

