local function addSlider(tab, label, min, max, default, callback)
    local h = IS_MOBILE and 60 or 50
    local row = mkFrame({ Size=UDim2.new(1,-4,0,h), BackgroundTransparency=0.35 }, tab)

    local range = max - min
    local dec = range <= 10 and 2 or (range <= 100 and 1 or 0)
    local function fmt(v) return string.format("%."..dec.."f", v) end

    mkText({
        Size=UDim2.new(1,-100,0,22),
        Position=UDim2.new(0,12,0,4),
        Text=label,
        TextSize=IS_MOBILE and 18 or 17,
    }, row)
    local valLbl = mkText({
        Size=UDim2.new(0,80,0,22),
        Position=UDim2.new(1,-92,0,4),
        Text=fmt(default),
        TextSize=IS_MOBILE and 18 or 17,
        TextXAlignment=Enum.TextXAlignment.Right,
    }, row)

    local trackH = IS_MOBILE and 6 or 4
    local hit = Instance.new("Frame")
    hit.Size=UDim2.new(1,-24,0,24)
    hit.Position=UDim2.new(0,12,0,IS_MOBILE and 30 or 24)
    hit.BackgroundTransparency=1
    hit.BorderSizePixel=0
    hit.Parent=row

    local track = mkFrame({
        Size=UDim2.new(1,0,0,trackH),
        Position=UDim2.new(0,0,0.5,-trackH/2),
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.8,
    }, hit)

    local rel0 = math.clamp((default-min)/(max-min), 0, 1)
    local fill = mkFrame({
        Size=UDim2.new(rel0,0,1,0),
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0,
    }, track)

    local kw, kh = IS_MOBILE and 10 or 7, IS_MOBILE and 22 or 16
    local knob = mkFrame({
        Size=UDim2.new(0,kw,0,kh),
        Position=UDim2.new(rel0,-kw/2,0.5,-kh/2),
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0,
        ZIndex=2,
    }, track)

    local dragging=false
    local function applyX(x)
        local rel = math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(rel,0,1,0)
        knob.Position=UDim2.new(rel,-kw/2,0.5,-kh/2)
        local val = min+(max-min)*rel
        valLbl.Text=fmt(val)
        if callback then pcall(callback, val) end
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1
           or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true
            applyX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1
           or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType~=Enum.UserInputType.MouseMovement
           and input.UserInputType~=Enum.UserInputType.Touch then return end
        applyX(input.Position.X)
    end)
end

