local function faceTargetStep(myRoot)
    if not CFG.FaceTarget then return end
    myRoot = myRoot or getMyRoot()
    if not myRoot then return end
    local tChar = target and target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end
    local aimPos = getAimPosition(tRoot) or tRoot.Position
    local lookTarget = Vector3.new(aimPos.X, myRoot.Position.Y, aimPos.Z)
    myRoot.CFrame = CFrame.new(myRoot.Position, lookTarget)
end

local function cameraLockStep(myRoot)
    if not CFG.LockCamera then aimMarker.Visible=false; return end
    myRoot = myRoot or getMyRoot()
    if not myRoot then aimMarker.Visible=false; return end
    local tChar = target and target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then aimMarker.Visible=false; return end
    local aimPos = getAimPosition(tRoot)
    if not aimPos then aimMarker.Visible=false; return end

    local camOffset = Camera.CFrame.Position - myRoot.Position
    local camPos = myRoot.Position + camOffset
    local desired = CFrame.new(camPos, aimPos)
    if CFG.CameraSmooth >= 1 then
        Camera.CFrame = desired
    else
        Camera.CFrame = Camera.CFrame:Lerp(desired, CFG.CameraSmooth)
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
    if onScreen then
        aimMarker.Visible = true
        aimMarker.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
        local acc = getAimAccuracy()
        if acc > 0.9 then
            aimStroke.Color = Color3.fromRGB(0,255,120)
            aimDot.BackgroundColor3 = Color3.fromRGB(0,255,120)
        elseif acc > 0.6 then
            aimStroke.Color = Color3.fromRGB(255,200,0)
            aimDot.BackgroundColor3 = Color3.fromRGB(255,200,0)
        else
            aimStroke.Color = Color3.fromRGB(255,60,60)
            aimDot.BackgroundColor3 = Color3.fromRGB(255,60,60)
        end
    else
        aimMarker.Visible = false
    end
end

local function orbitTeleportStep(dt)
    if not CFG.AutoKill then return end
    if tick() < dodgeUntil or tick() < counterUntil or tick() < evasiveUntil then return end
    local myRoot = getMyRoot(); if not myRoot then return end
    if detectFling(myRoot) then doDefling(myRoot); return end
    local tChar = target and target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end
    local r = getTargetHitboxRadius()
    local enemyLook = tRoot.CFrame.LookVector
    local enemyFlat = Vector3.new(enemyLook.X, 0, enemyLook.Z)
    local baseAngle
    if enemyFlat.Magnitude > 0.05 then
        enemyFlat = enemyFlat.Unit
        local backX = -enemyFlat.X
        local backZ = -enemyFlat.Z
        baseAngle = math.atan2(backZ, backX)
    else
        baseAngle = orbitAngle
    end

    if CFG.BackstabOnly then
        orbitAngle = baseAngle + math.sin(tick() * 2) * CFG.BackstabOffset
    else
        orbitAngle = orbitAngle + CFG.OrbitSpeed * dt
    end

    local offset = Vector3.new(
        math.cos(orbitAngle) * r,
        0,
        math.sin(orbitAngle) * r
    )
    local pos = tRoot.Position + offset
    pos = getSafePosition(pos, tRoot)

    local targetY = tRoot.Position.Y
    local myY = myRoot.Position.Y

    if targetY - myY > CFG.MaxVerticalDiff then
        pos = Vector3.new(pos.X, myY, pos.Z)
    else
        pos = Vector3.new(pos.X, targetY + CFG.OrbitHeight, pos.Z)
    end

    do
        local rayOrigin = Vector3.new(pos.X, pos.Y + 50, pos.Z)
        local rayDir = Vector3.new(0, -300, 0)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character }
        local hit = workspace:Raycast(rayOrigin, rayDir, params)
        if hit then
            local maxY = hit.Position.Y + CFG.GroundOffset
            if pos.Y > maxY then
                pos = Vector3.new(pos.X, maxY, pos.Z)
            end
        end
    end

    local aimPos = getAimPosition(tRoot) or tRoot.Position
    local lookAt = Vector3.new(aimPos.X, pos.Y, aimPos.Z)
    myRoot.CFrame = CFrame.new(pos, lookAt)

    if myRoot.Position.Y > -100 and myRoot.Position.Y < 400 then
        lastSafePos = myRoot.Position
    end

    if CFG.MicroVelocity then
        local toward = tRoot.Position - myRoot.Position
        local flat = Vector3.new(toward.X, 0, toward.Z)
        if flat.Magnitude > 0.5 then
            myRoot.AssemblyLinearVelocity = flat.Unit * CFG.MicroVelPower
        else
            myRoot.AssemblyLinearVelocity = Vector3.zero
        end
    else
        myRoot.AssemblyLinearVelocity = Vector3.zero
    end
    myRoot.AssemblyAngularVelocity = Vector3.zero
end

local function dispatchInputs()
    if not CFG.AutoKill then return end
    if not target or not isTargetAlive() then return end
    if tick() < dodgeUntil or tick() < counterUntil or tick() < evasiveUntil then return end
    local myRoot = getMyRoot()
    if myRoot and detectFling(myRoot) then doDefling(myRoot); return end
    if CFG.ValidateAim then
        local acc = getAimAccuracy()
        local facing = getBodyFacingAccuracy()
        if acc < 0.85 or facing < 0.9 then
            missCount = missCount + 1
            if CFG.RepositionOnMiss and missCount >= CFG.MaxMissBeforeReposition then
                missCount = 0
                local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                if myRoot and tRoot then
                    local r = getTargetHitboxRadius()
                    local perp = Vector3.new(1,0,0)
                    local toT = tRoot.Position - myRoot.Position
                    if toT.Magnitude > 0.1 then
                        local flat = Vector3.new(toT.X, 0, toT.Z).Unit
                        perp = Vector3.new(-flat.Z, 0, flat.X)
                    end
                    local newPos = tRoot.Position + perp * r + Vector3.new(0, CFG.OrbitHeight, 0)
                    newPos = getSafePosition(newPos, tRoot)
                    local aimPos = getAimPosition(tRoot) or tRoot.Position
                    myRoot.CFrame = CFrame.new(newPos, Vector3.new(aimPos.X, newPos.Y, aimPos.Z))
                end
            end
            return
        end
        missCount = 0
    end
    local now = tick()
    local nowMs = now * 1000
    if CFG.M1_Auto and now - lastM1 >= CFG.M1_Rate then
        lastM1 = now
        m1Down()
        if CFG.M1_Multicast then
            task.defer(function()
                task.wait(0.005); m1Down()
                task.wait(0.005); m1Up()
            end)
        end
        m1UpAt = nowMs + CFG.M1_HoldMs
        m1Count = m1Count + 1
    end
    if m1UpAt > 0 and nowMs >= m1UpAt then m1Up(); m1UpAt = 0 end
    if CFG.Skill_Auto and now - lastSkill >= CFG.Skill_Interval then
        lastSkill = now
        local key = CFG.Skill_Keys[CFG.skillIndex or 1]
        keyDown(key)
        pendingSkill = key
        skillUpAt = nowMs + CFG.Skill_HoldMs
        skillCount = skillCount + 1
        CFG.skillIndex = ((CFG.skillIndex or 1) % #CFG.Skill_Keys) + 1
    end
    if skillUpAt > 0 and nowMs >= skillUpAt then
        if pendingSkill then keyUp(pendingSkill); pendingSkill = nil end
        skillUpAt = 0
    end
    if CFG.Dash_Auto and now - lastDash >= CFG.Dash_Interval then
        lastDash = now
        keyDown(CFG.Dash_Key)
        dashUpAt = nowMs + 70
        dashCount = dashCount + 1
    end
    if dashUpAt > 0 and nowMs >= dashUpAt then keyUp(CFG.Dash_Key); dashUpAt = 0 end
end

local function targetStep()
    if not CFG.AutoKill then return end
    local now = tick()

    if not target then
        targetDeadSince, targetLastHP, targetBestHP = nil, nil, nil
        if now - lastTarget >= 0.15 then
            lastTarget = now
            target = pickTarget()
            if target then
                local hp = getPlayerHP(target)
                targetLastHP, targetBestHP = hp, hp
                targetProgressAt = now
                orbitAngle = 0
                targetAnimTimes = {}
                missCount = 0
            end
        end
        return
    end

    local myRoot = getMyRoot()
    local tChar = target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if myRoot and tRoot then
        local d = (tRoot.Position - myRoot.Position).Magnitude
        if d > CFG.MaxTargetDist * 1.5 then
            releaseAllInputs()
            target, targetDeadSince = nil, nil
            targetLastHP, targetBestHP = nil, nil
            lastTarget = 0
            return
        end
    end

    local hum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local hp = hum and hum.Health or 0

    if hum and hp > 0 then
        targetDeadSince = nil
        if targetLastHP and hp < targetLastHP then
            targetProgressAt = now
        end
        targetLastHP = hp
        if CFG.KillTimeout and (now - targetProgressAt) > CFG.KillTimeout then
            immortalList[target] = true
            releaseAllInputs()
            target, targetDeadSince = nil, nil
            targetLastHP, targetBestHP = nil, nil
            lastTarget = 0
        end
        return
    end

    if not targetDeadSince then targetDeadSince = now end
    if now - targetDeadSince >= CFG.KillConfirmTime then
        killedList[target] = true
        clearTargetConns()
        releaseAllInputs()
        target, targetDeadSince = nil, nil
        targetLastHP, targetBestHP = nil, nil
