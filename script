local function selectTab(name)
    currentTab=name
    for tname, tframe in pairs(tabs) do tframe.Visible=(tname==name) end
    for tname, btn in pairs(tabButtons) do
        local active = (tname==name)
        tween(btn, 0.12, {
            BackgroundColor3 = active and THEME.TAB_ACTIVE or THEME.TAB_IDLE,
            BackgroundTransparency = active and 0.15 or 0.35,
            TextColor3 = active and THEME.TEXT or THEME.TEXT_DIM,
        })
        if tabIndicators[tname] then tabIndicators[tname].Visible = active end
    end
end

