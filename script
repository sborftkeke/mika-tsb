RunService.RenderStepped:Connect(function()
    local now = tick()
    local dt = now - last
    last = now

    for plr, _ in pairs(espCache) do
        if not plr.Parent then
            destroyESP(plr)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end

        local esp = espCache[plr]
        local char = plr.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
        local root = char and char:FindFirstChild("HumanoidRootPart")

        local valid = CFG.ESP and char and head and root and hum and hum.Health > 0

        if not valid then
            if esp then
                esp.billboard.Enabled = false
                esp.box.Visible = false
                esp.hl.Enabled = false
                esp.hl.Adornee = nil
                esp.billboard.Adornee = nil
                esp.root = nil
            end
            if not char and esp then
                destroyESP(plr)
            end
            continue
        end

        if not esp then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "OllieESP_"..plr.Name
            billboard.Size = UDim2.new(0,180,0,70)
            billboard.StudsOffsetWorldSpace = Vector3.new(0,3,0)
            billboard.AlwaysOnTop = true
            billboard.MaxDistance = 2000
            billboard.Parent = hudGui
            local nameLabel = mkText({
                Size=UDim2.new(1,0,0,16),
                Font=FONT_BOLD, TextSize=16,
                TextXAlignment=Enum.TextXAlignment.Center,
                TextStrokeTransparency=0,
            }, billboard)
            local hpLabel = mkText({
                Size=UDim2.new(1,0,0,14),
                Position=UDim2.new(0,0,0,16),
                Font=FONT_BOLD, TextSize=15,
                TextColor3=Color3.fromRGB(255,100,100),
                TextXAlignment=Enum.TextXAlignment.Center,
                TextStrokeTransparency=0,
            }, billboard)
            local distLabel = mkText({
                Size=UDim2.new(1,0,0,14),
                Position=UDim2.new(0,0,0,30),
                TextSize=15,
                TextColor3=Color3.fromRGB(255,140,180),
                TextXAlignment=Enum.TextXAlignment.Center,
                TextStrokeTransparency=0,
            }, billboard)
            local box = Instance.new("Frame")
            box.Name = "OllieESPBox_"..plr.Name
            box.BackgroundTransparency=1
            box.AnchorPoint=Vector2.new(0.5,0.5)
            box.Visible=false
            box.Parent=hudGui
            local stroke = Instance.new("UIStroke")
            stroke.Color=Color3.fromRGB(255,60,120)
            stroke.Thickness=1.5
            stroke.Parent=box
            local hl = Instance.new("Highlight")
            hl.Name = "OllieESP_HL_"..plr.Name
            hl.FillColor=Color3.fromRGB(255,60,120)
            hl.FillTransparency=0.7
            hl.OutlineColor=Color3.fromRGB(255,255,255)
            hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            hl.Enabled=false
            hl.Parent=hudGui
            esp = {
                billboard=billboard, nameLabel=nameLabel,
                hpLabel=hpLabel, distLabel=distLabel,
                box=box, stroke=stroke, hl=hl, root=nil,
            }
            espCache[plr] = esp
        end

        esp.root = root
        esp.billboard.Adornee = head
        esp.billboard.Enabled = true
        esp.hl.Adornee = char

        local hp, maxhp = getPlayerHP(plr)
        esp.nameLabel.Visible = CFG.ESP_Names
        esp.nameLabel.Text = (plr == target) and ("[ALVO] "..plr.Name) or plr.Name
        esp.hpLabel.Visible = CFG.ESP_ShowHP and hp ~= nil
        if hp then
            esp.hpLabel.Text = string.format("HP: %d / %d", math.floor(hp), math.floor(maxhp or hp))
        end
        esp.distLabel.Visible = CFG.ESP_Distance
        local myRoot = getMyRoot()
        if myRoot then
            esp.distLabel.Text = string.format("%d studs", (root.Position - myRoot.Position).Magnitude)
        end

        if CFG.ESP_Boxes then
            local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,3,0))
            local botPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
            local h = math.abs(botPos.Y - topPos.Y)
            if onScreen and h > 4 and h < 2000 then
                esp.box.Visible = true
                esp.box.Size = UDim2.new(0, h*0.6, 0, h)
                esp.box.Position = UDim2.new(0, headPos.X, 0, (topPos.Y+botPos.Y)/2)
            else
                esp.box.Visible = false
            end
        else
            esp.box.Visible = false
        end

        esp.hl.Enabled = CFG.ESP_Highlight

        if plr == target then
            esp.stroke.Color = Color3.fromRGB(0,255,120)
            esp.nameLabel.TextColor3 = Color3.fromRGB(0,255,120)
            esp.hl.FillColor = Color3.fromRGB(0,255,120)
        elseif immortalList[plr] then
            esp.stroke.Color = Color3.fromRGB(255,200,0)
            esp.nameLabel.TextColor3 = Color3.fromRGB(255,200,0)
            esp.hl.FillColor = Color3.fromRGB(255,200,0)
        elseif killedList[plr] then
            esp.stroke.Color = Color3.fromRGB(120,120,120)
            esp.nameLabel.TextColor3 = Color3.fromRGB(120,120,120)
            esp.hl.FillColor = Color3.fromRGB(120,120,120)
        else
            esp.stroke.Color = Color3.fromRGB(255,60,120)
            esp.nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
            esp.hl.FillColor = Color3.fromRGB(255,60,120)
        end
    end

    if CFG.HitCounter then
        local tname = target and target.Name or "-"
        local hpStr = "-"
        if target then
            local hp = getPlayerHP(target)
            if hp then hpStr = tostring(math.floor(hp)) end
        end
        local acc = math.floor(getAimAccuracy()*100)
        local facing = math.floor(getBodyFacingAccuracy()*100)
        local facingStr = facing >= 95 and "OK" or (facing >= 80 and "~" or "X")
        hitLabel.Text = string.format(
            "M1:%d S:%d D:%d C:%d E:%d F:%d | %s | HP:%s | AIM:%d%% | VIRADO:%s(%d%%)",
            m1Count, skillCount, dashCount, counterCount, evasiveCount, flingCount,
            tname, hpStr, acc, facingStr, facing
        )
    end

    if CFG.AutoKill then
        orbitTeleportStep(dt)
        local myRoot = getMyRoot()
        if myRoot then
            faceTargetStep(myRoot)
            cameraLockStep(myRoot)
        end
        dispatchInputs()
        targetStep()
    end
end)
