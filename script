local function getMyRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getPlayerHP(plr)
    if not plr or not plr.Character then return nil end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return hum.Health, hum.MaxHealth
end
local function isLikelyImmortal(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return hum.MaxHealth == math.huge or hum.MaxHealth > 100000
end
local function isTargetAlive()
    if not target or not target.Character then return false end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end
local function getTargetHitboxRadius()
    if not target or not target.Character then return CFG.OrbitRadius end
    if not CFG.DynamicHitbox then return CFG.OrbitRadius end
    local head = target.Character:FindFirstChild("Head")
    if head then
        local r = math.max(head.Size.X, head.Size.Z) * 1.5 + CFG.HitboxPadding
        return math.clamp(r, 1.5, CFG.OrbitRadius + 0.5)
    end
    return CFG.OrbitRadius
end
local function getAimPosition(tRoot)
    if not target or not target.Character or not tRoot then
        return tRoot and tRoot.Position
    end
    local char = target.Character
    if CFG.AimTarget == "head" then
        local head = char:FindFirstChild("Head")
        if head then return head.Position end
    elseif CFG.AimTarget == "root" then
        return tRoot.Position
    end
    local head = char:FindFirstChild("Head")
    if head then
        local mid = (head.Position + tRoot.Position) * 0.5
        return mid + Vector3.new(0, CFG.AimOffset, 0)
    end
    return tRoot.Position + Vector3.new(0, CFG.AimOffset, 0)
end
local function getAimAccuracy()
    if not target or not target.Character then return 0 end
    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot then return 0 end
    local aimPos = getAimPosition(tRoot)
    if not aimPos then return 0 end
    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
    if not onScreen then return 0 end
    local vp = Camera.ViewportSize
    local cx, cy = vp.X/2, vp.Y/2
    local dx = (screenPos.X - cx) / cx
    local dy = (screenPos.Y - cy) / cy
    return math.clamp(1 - math.sqrt(dx*dx + dy*dy), 0, 1)
end
local function getBodyFacingAccuracy()
    local myRoot = getMyRoot()
    if not myRoot then return 0 end
    local tChar = target and target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return 0 end
    local toT = tRoot.Position - myRoot.Position
    local flat = Vector3.new(toT.X, 0, toT.Z)
    if flat.Magnitude < 0.1 then return 1 end
    flat = flat.Unit
    local myLook = myRoot.CFrame.LookVector
    local myFlat = Vector3.new(myLook.X, 0, myLook.Z)
    if myFlat.Magnitude < 0.1 then return 0 end
    myFlat = myFlat.Unit
    return math.clamp(myFlat:Dot(flat), 0, 1)
end
local function getSafePosition(desiredPos, tRoot)
    if not CFG.AntiOverlap or not tRoot then return desiredPos end
    local diff = desiredPos - tRoot.Position
    local dist = diff.Magnitude
    if dist >= CFG.AntiOverlapDist then return desiredPos end
    if dist < 0.01 then
        diff = Vector3.new(math.random()-0.5, 0.2, math.random()-0.5)
    end
    return tRoot.Position + diff.Unit * CFG.AntiOverlapDist
end
