local function detectFling(myRoot)
    if not CFG.PreventFling or not myRoot then return false end
    local speed = myRoot.AssemblyLinearVelocity.Magnitude
    local pos = myRoot.Position
    if speed > 500 then return true end
    if pos.Y > 500 or pos.Y < -200 then return true end
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return true end
    return false
end
local function doDefling(myRoot)
    if not myRoot then return end
    flingCount = flingCount + 1
    pcall(function()
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        if lastSafePos then myRoot.CFrame = CFrame.new(lastSafePos) end
    end)
    applyNoCollide(LocalPlayer.Character)
end
local function applyStealth(on)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = on and 1 or 0
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = on and 1 or 0
        elseif part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
            part.Enabled = not on
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        if on then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.DisplayName = ""
        else
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
            hum.DisplayName = origName
        end
    end
end
